# HTTP
PORT=3000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgres://wagering:wagering@localhost:5432/wagering

# SQS (MiniStack)
SQS_ENDPOINT=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_QUEUE_URL=http://localhost:4566/000000000000/wager-transactions.fifo
SQS_DLQ_URL=http://localhost:4566/000000000000/wager-transactions-dlq.fifo
SQS_EVENTS_URL=http://localhost:4566/000000000000/wager-events.fifo

# Workers (build-time tuning constants)
INBOX_MAX_RECEIVE_COUNT=5
INBOX_VISIBILITY_TIMEOUT=30
PENDING_REFERENCE_INTERVAL_MS=30000
OUTBOX_POLL_INTERVAL_MS=2000
