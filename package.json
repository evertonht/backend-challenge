{
  "name": "wagering-processor",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "bun run src/main.ts",
    "start:dev": "bun --watch run src/main.ts",
    "test": "bun test test/unit",
    "test:integration": "bun test test/integration",
    "test:concurrency": "bun test test/concurrency",
    "queues:ensure": "bun run scripts/ensure-queues.ts",
    "migration:create": "bunx --bun mikro-orm migration:create --config src/infrastructure/persistence/mikro-orm.config.ts",
    "migration:up": "bunx --bun mikro-orm migration:up --config src/infrastructure/persistence/mikro-orm.config.ts",
    "migration:down": "bunx --bun mikro-orm migration:down --config src/infrastructure/persistence/mikro-orm.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1161.0",
    "@mikro-orm/core": "6",
    "@mikro-orm/migrations": "6",
    "@mikro-orm/postgresql": "6",
    "@mikro-orm/reflection": "6",
    "@nestjs/common": "^12.3.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-express": "^12.3.2",
    "big.js": "^7.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "pino": "^10.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@mikro-orm/cli": "6",
    "@nestjs/cli": "^12.0.11",
    "@types/big.js": "^7.0.0",
    "@types/bun": "^1.4.4",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "pino-pretty": "^13.2.0",
    "typescript": "5.9"
  }
}
